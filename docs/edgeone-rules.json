{
  "FormatVersion": "1.0",
  "Rules": [
    {
      "RuleName": "litematic-webview",
      "Status": "enable",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['litematic.zuoqirun.top']",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "FollowOrigin": {
                  "Switch": "on",
                  "DefaultCache": "on",
                  "DefaultCacheStrategy": "on",
                  "DefaultCacheTime": 0
                }
              }
            },
            {
              "Name": "CacheKey",
              "CacheKeyParameters": {
                "FullURLCache": "on",
                "IgnoreCase": "off"
              }
            }
          ],
          "SubRules": [
            {
              "Branches": [
                {
                  "Condition": "${http.request.uri.path} matches '^/api/'",
                  "Actions": [
                    {
                      "Name": "Cache",
                      "CacheParameters": {
                        "NoCache": {
                          "Switch": "on"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Branches": [
                {
                  "Condition": "${http.request.file_extension} in ['html', 'htm']",
                  "Actions": [
                    {
                      "Name": "Cache",
                      "CacheParameters": {
                        "NoCache": {
                          "Switch": "on"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Branches": [
                {
                  "Condition": "${http.request.file_extension} in ['js', 'css', 'json', 'png', 'webp', 'jpg', 'jpeg', 'svg', 'ico', 'woff', 'woff2', 'litematic']",
                  "Actions": [
                    {
                      "Name": "Cache",
                      "CacheParameters": {
                        "CustomTime": {
                          "Switch": "on",
                          "CacheTime": 86400
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
